
extends layout

block content
  h2 Lisää uusi asiakas

  form(action="/customers/add", method="POST")
    label(for="firstname") Etunimi
    input(
      type="text"
      id="firstname"
      name="firstname"
      required
    )

    label(for="lastname") Sukunimi
    input(
      type="text"
      id="lastname"
      name="lastname"
      required
    )

    label(for="email") Sähköposti
    input(
      type="email"
      id="email"
      name="email"
      required
    )

    label(for="phone") Puhelin
    input(
      type="tel"
      id="phone"
      name="phone"
      required
    )

    button(type="submit") Tallenna asiakas

  p
    a(href="/customers") Takaisin asiakaslistaan
